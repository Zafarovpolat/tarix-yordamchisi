# Проект хранится в чистом LF (проверено: 0 байт CR в index.html, netlify.toml,
# функциях). Глобальный core.autocrlf=true на этой машине иначе превратил бы
# рабочую копию в CRLF при первом же checkout — запрещаем конвертацию явно.
* text=auto eol=lf

# Бинарники не трогать вообще
*.glb binary
*.wasm binary
